#!/bin/bash

#SBATCH --job-name=random-policies
#SBATCH --output=outputs/random-policies-%A_%a.out 
#SBATCH --time=1:00:00       
#SBATCH --ntasks=1
#SBATCH --gpus-per-task=1
#SBATCH --array=0-30

cd ~/envelope-bench
source .venv/bin/activate
hostname
nvidia-smi --list-gpus           

srun python -m wandb agent flair/envelope-bench/m7vgdmi8